# ==============================================================================
# Python & Django
# ==============================================================================
# Python execution cache
__pycache__/
*.py[cod]
*$py.class

# Local database files (SQLite)
*.sqlite3
*.sqlite3-journal

# Locally uploaded media and static files
/media/
/static/
!/static/images/ # Uncomment if you store base design images here

# Test reports and code coverage
htmlcov/
.toml
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log

# ==============================================================================
# uv & Virtual Environments
# ==============================================================================
# uv-specific cache folder
.uv/

# Standard virtual environment generated by uv (.venv)
.venv/
env/
venv/
ENV/

# Dependency lock files
# NOTE: uv.lock MUST be committed to the repository for final projects/applications.
# Uncomment the line below ONLY if you are creating a shared library. # uv.lock

# ==============================================================================
# Docker
# ==============================================================================
# Data persisted by local Docker volumes (e.g., PostgreSQL, Redis)
.docker_data/
docker_volumes/
pgdata/

# Docker log file (if output is redirected)
*.docker.log

# ==============================================================================
# Environment Variables and Security (CRITICAL!)
# ==============================================================================
# Files containing passwords, API keys, and SECRET_KEY
.env
.env.[a-zA-Z]*
!.env.example # Allow the example template file
.secrets
secrets.json

# ==============================================================================
# IDEs and Operating Systems
# ==============================================================================
# VS Code
.vscode/
!.vscode/extensions.json

# PyCharm / IntelliJ
.idea/

# Operating System
.DS_Store
Thumbs.db
